{
  "manifest_version": 3,
  "name": "Nono Smart Bookmark",
  "version": "0.2.2",
  "description": "快速把当前网页收藏到 Nono。",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "NONO 快速收藏",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/nono-16.png",
      "32": "icons/nono-32.png",
      "48": "icons/nono-48.png",
      "128": "icons/nono-128.png"
    }
  },
  "icons": {
    "16": "icons/nono-16.png",
    "32": "icons/nono-32.png",
    "48": "icons/nono-48.png",
    "128": "icons/nono-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "打开 Nono 快速收藏"
    },
    "quick-save-last-folder": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "保存到上次使用的文件夹"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
