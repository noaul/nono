{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.4.1",
  "description": "__MSG_extDescription__",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "homepage_url": "https://github.com/noaul/nono",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/nono-16.png",
      "32": "icons/nono-32.png",
      "48": "icons/nono-48.png",
      "128": "icons/nono-128.png"
    }
  },
  "icons": {
    "16": "icons/nono-16.png",
    "32": "icons/nono-32.png",
    "48": "icons/nono-48.png",
    "128": "icons/nono-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open-quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "__MSG_commandOpenPopup__"
    },
    "quick-save-last-folder": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "__MSG_commandQuickSave__"
    },
    "clip-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "__MSG_commandClipPage__"
    }
  }
}
