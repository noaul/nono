generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       Int                       @id @default(autoincrement())
  username                 String                    @unique
  email                    String                    @unique
  displayName              String
  passwordHash             String
  role                     String                    @default("user")
  llmProvider              String?
  llmApiKey                String?
  llmModel                 String?
  llmBaseUrl               String?
  llmReasoningEffort       String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sites                    Site[]
  folders                  Folder[]
  trashItems               TrashItem[]
  apiTokens                ApiToken[]
  authSessions             AuthSession[]
  passkeys                 PasskeyCredential[]
  webAuthnChallenges       WebAuthnChallenge[]
  notificationStates       NotificationState[]
  notificationChannels     NotificationChannel[]
  mobileDevices            MobileDevice[]
  mobileEvents             MobileEvent[]
  auditLogs                AuditLog[]
  mobileBookmarkRequests   MobileBookmarkRequest[]
  noStarAccount            NoStarAccount?
  noStarRepositories       NoStarRepository[]
  noStarReleases           NoStarRelease[]
  noStarCategories         NoStarCategory[]
  noStarAiProfiles         NoStarAiProfile[]
  noStarWebDavConfigs      NoStarWebDavConfig[]
  noStarAssetFilters       NoStarAssetFilter[]
  noStarSettings           NoStarSetting[]
  noStarEmbeddingConfigs   NoStarEmbeddingConfig[]
  noStarVectorSearchConfig NoStarVectorSearchConfig?
}

model NotificationState {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

/// Where a user's notifications are pushed. Secret config fields are encrypted with ENCRYPTION_KEY.
model NotificationChannel {
  id            Int                    @id @default(autoincrement())
  userId        Int
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  name          String
  enabled       Boolean                @default(true)
  minSeverity   String                 @default("warning")
  config        Json                   @default("{}")
  lastSuccessAt DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deliveries    NotificationDelivery[]

  @@index([userId])
}

/// One push of one notification to one channel; also what stops a notification being sent twice.
model NotificationDelivery {
  id        Int                 @id @default(autoincrement())
  userId    Int
  channelId Int
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  key       String
  source    String
  title     String
  status    String
  error     String?
  attempts  Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([channelId, key])
  @@index([userId, updatedAt])
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  mobileDevices MobileDevice[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A phone that receives push notifications for one account. The vendor registration token is
/// encrypted with ENCRYPTION_KEY; registrationHash (keyed HMAC) only enforces uniqueness. A device
/// is eligible for delivery only while it is enabled, unrevoked and its browser session is alive,
/// so every way a session ends (logout, password change, manual revoke, expiry, user deletion)
/// also stops pushes.
model MobileDevice {
  id                     String       @id @default(uuid())
  userId                 Int
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId              String?
  session                AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  installationId         String
  provider               String
  registrationCiphertext String
  registrationHash       String
  revokeTokenHash        String
  enabled                Boolean      @default(true)
  revokedAt              DateTime?
  disabledReason         String?
  appVersion             String
  lastRegisteredAt       DateTime     @default(now())
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  pushAttempts           MobilePushAttempt[]

  @@unique([provider, registrationHash])
  @@unique([userId, installationId])
  @@index([sessionId])
}

/// A pushable event for one user. (userId, source, eventId) is the source's stable identity, so
/// discovering or relaying the same event again never creates a second set of pushes.
model MobileEvent {
  id         Int                 @id @default(autoincrement())
  userId     Int
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String
  eventId    String
  severity   String
  /// Shown only to the signed-in owner on the landing page; never sent to the push vendor.
  title      String              @default("")
  targetPath String
  occurredAt DateTime
  expiresAt  DateTime
  createdAt  DateTime            @default(now())
  attempts   MobilePushAttempt[]

  @@unique([userId, source, eventId])
  @@index([userId, eventId])
  @@index([expiresAt])
}

/// Durable outbox row: one push of one event to one device. Workers lease rows with
/// FOR UPDATE SKIP LOCKED, call the vendor outside the transaction and finish the row only while
/// they still hold the lease (leaseToken).
model MobilePushAttempt {
  id                String       @id @default(uuid())
  eventRowId        Int
  event             MobileEvent  @relation(fields: [eventRowId], references: [id], onDelete: Cascade)
  deviceId          String
  device            MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userId            Int
  /// pending | sending | accepted | failed | canceled | expired. "accepted" means the vendor took it,
  /// not that the phone showed it.
  status            String       @default("pending")
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  leaseUntil        DateTime?
  leaseToken        String?
  providerMessageId String?
  errorCode         String?
  acceptedAt        DateTime?
  openedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([eventRowId, deviceId])
  @@index([status, nextAttemptAt])
  @@index([deviceId, status])
  @@index([userId, updatedAt])
}

model PasskeyCredential {
  id         String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports Json     @default("[]")
  deviceType String
  backedUp   Boolean  @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

model Site {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String
  slug              String   @unique
  backgroundImage   String?
  backgroundColor   String   @default("#000000")
  fontColor         String   @default("#ffffff")
  searchUrlTemplate String   @default("https://www.google.com/search?q={query}")
  localSearchFirst  Boolean  @default(true)
  guestAccessEnabled      Boolean  @default(false)
  guestAccessPasswordHash String?
  settings          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Folder {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     Int?
  parent       Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[] @relation("FolderTree")
  name         String
  icon         String?
  description  String?
  sortOrder    Int      @default(0)
  passwordHash String?
  passwordHint String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  links        Link[]

  @@index([userId, parentId, sortOrder])
}

model Link {
  id               Int       @id @default(autoincrement())
  folderId         Int
  folder           Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name             String
  url              String
  icon             String?
  description      String?
  sortOrder        Int       @default(0)
  healthCheckEnabled Boolean @default(true)
  healthStatus     String?
  healthStatusCode Int?
  healthReason     String?
  healthFinalUrl   String?
  healthCheckedAt  DateTime?
  clickCount       Int       @default(0)
  lastClickedAt    DateTime?
  /// Queued for reading later; the reading inbox lists links with this set and readAt unset.
  readLaterAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // The table also has a generated "searchText" column with a trigram index (migration
  // 20261002010000_link_search). It is left out here on purpose; searchLinks queries it in raw SQL.
  @@index([folderId, sortOrder])
  @@index([healthCheckedAt])
  @@index([clickCount, lastClickedAt])
  @@index([readLaterAt])
  // Hash, not btree: duplicate checks only need equality, and a btree entry has a size limit long URLs can exceed.
  @@index([url], type: Hash)
}

/// Idempotency record for POST /api/mobile/bookmarks: a retried share with the same requestId
/// returns the bookmark it first produced instead of saving it again.
model MobileBookmarkRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String
  contentHash String
  /// Not a foreign key: the bookmark may go to the trash and come back with the same id.
  linkId      Int?
  /// "created" or "existing" (the URL was already bookmarked, so nothing new was saved).
  outcome     String
  createdAt   DateTime @default(now())

  @@unique([userId, requestId])
  @@index([createdAt])
}

model TrashItem {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  entityId  Int
  label     String
  payload   Json
  deletedAt DateTime @default(now())

  @@index([userId, deletedAt])
}

model ApiToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token")
  tokenPrefix String
  name        String
  scopes      String[]  @default(["bookmarks:read", "bookmarks:write", "ai:analyze"])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AppConfig {
  id                Int     @id @default(1)
  allowRegistration Boolean @default(false)
  defaultRole       String  @default("user")
  settings          Json    @default("{}")
  initializedAt     DateTime?
  /// Set once NoMoney/Yumi channel settings have been imported into NotificationChannel.
  notificationChannelsImportedAt DateTime?
}

model BackupAutomation {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  cadence          String   @default("daily")
  hour             Int      @default(3)
  weekday          Int      @default(0)
  retentionDays    Int      @default(30)
  maxBackups       Int      @default(7)
  lastScheduledFor String?
  lastStartedAt    DateTime?
  lastCompletedAt  DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditConfig {
  id            Int      @id @default(1)
  retentionDays Int      @default(180)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUsername String
  actorRole     String
  action        String
  resourceType  String
  resourceId    String?
  resourceLabel String?
  result        String
  statusCode    Int
  ipAddress     String?
  userAgent     String?
  details       Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([result, createdAt])
}

model NoStarAccount {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin          String?
  githubName           String?
  githubAvatarUrl      String?
  githubTokenEncrypted String?
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model NoStarRepository {
  id                   Int             @id @default(autoincrement())
  userId               Int
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId             BigInt
  name                 String
  fullName             String
  description          String?
  htmlUrl              String
  licenseKey           String?
  licenseName          String?
  licenseSpdxId        String?
  stargazersCount      Int             @default(0)
  language             String?
  githubCreatedAt      DateTime?
  githubUpdatedAt      DateTime?
  githubPushedAt       DateTime?
  starredAt            DateTime?
  ownerLogin           String
  ownerAvatarUrl       String?
  topics               Json            @default("[]")
  aiSummary            String?
  aiTags               Json            @default("[]")
  aiPlatforms          Json            @default("[]")
  analyzedAt           DateTime?
  analysisFailed       Boolean         @default(false)
  customDescription    String?
  customTags           Json            @default("[]")
  customCategory       String?
  categoryLocked       Boolean         @default(false)
  lastEditedAt         DateTime?
  subscribedToReleases Boolean         @default(false)
  vectorIndexedAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  releases             NoStarRelease[]

  @@unique([userId, githubId])
  @@unique([userId, fullName])
  @@index([userId, starredAt])
  @@index([userId, customCategory])
}

model NoStarRelease {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId     BigInt
  repositoryId Int
  repository   NoStarRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tagName      String
  name         String?
  body         String?
  publishedAt  DateTime?
  htmlUrl      String?
  assets       Json             @default("[]")
  zipballUrl   String?
  tarballUrl   String?
  repoFullName String
  repoName     String
  prerelease   Boolean          @default(false)
  draft        Boolean          @default(false)
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, githubId])
  @@index([userId, publishedAt])
  @@index([repositoryId])
}

model NoStarCategory {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId    String?
  name        String
  description String?
  icon        String   @default("folder")
  keywords    Json     @default("[]")
  color       String?
  sortOrder   Int      @default(0)
  isCustom    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, sortOrder])
}

model NoStarAiProfile {
  id              String   @id @default(uuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String
  name            String
  apiType         String   @default("openai")
  baseUrl         String
  apiKeyEncrypted String?
  model           String
  isActive        Boolean  @default(false)
  customPrompt    String?
  useCustomPrompt Boolean  @default(false)
  concurrency     Int      @default(1)
  reasoningEffort String?
  mimoPlan        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarWebDavConfig {
  id                String   @id @default(uuid())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId          String
  name              String
  url               String
  username          String
  passwordEncrypted String?
  path              String   @default("/")
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarAssetFilter {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId    String
  name        String
  description String?
  keywords    Json     @default("[]")
  platform    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, sortOrder])
}

model NoStarSetting {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model NoStarEmbeddingConfig {
  id              String                     @id @default(uuid())
  userId          Int
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String
  name            String
  apiType         String                     @default("openai")
  baseUrl         String                     @default("")
  apiKeyEncrypted String?
  model           String                     @default("")
  dimensions      Int                        @default(1536)
  isActive        Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  vectorConfigs   NoStarVectorSearchConfig[]

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarVectorSearchConfig {
  id                 Int                    @id @default(autoincrement())
  userId             Int                    @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled            Boolean                @default(false)
  workerUrl          String                 @default("")
  authTokenEncrypted String?
  embeddingConfigId  String?
  embeddingConfig    NoStarEmbeddingConfig? @relation(fields: [embeddingConfigId], references: [id], onDelete: SetNull)
  indexMode          String                 @default("readme")
  readmeMaxChars     Int                    @default(6000)
  status             Json?
  lastSyncAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}
