generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  username                 String                    @unique
  email                    String                    @unique
  displayName              String
  passwordHash             String
  role                     String                    @default("user")
  llmProvider              String?
  llmApiKey                String?
  llmModel                 String?
  llmBaseUrl               String?
  llmReasoningEffort       String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sites                    Site[]
  folders                  Folder[]
  trashItems               TrashItem[]
  apiTokens                ApiToken[]
  authSessions             AuthSession[]
  passkeys                 PasskeyCredential[]
  webAuthnChallenges       WebAuthnChallenge[]
  notificationStates       NotificationState[]
  auditLogs                AuditLog[]
  noStarAccount            NoStarAccount?
  noStarRepositories       NoStarRepository[]
  noStarReleases           NoStarRelease[]
  noStarCategories         NoStarCategory[]
  noStarAiProfiles         NoStarAiProfile[]
  noStarWebDavConfigs      NoStarWebDavConfig[]
  noStarAssetFilters       NoStarAssetFilter[]
  noStarSettings           NoStarSetting[]
  noStarEmbeddingConfigs   NoStarEmbeddingConfig[]
  noStarVectorSearchConfig NoStarVectorSearchConfig?
  clips                    Clip[]
  clipTags                 ClipTag[]
  clipTagLinks             ClipTagOnClip[]
  clipHighlights           ClipHighlight[]
}

model NotificationState {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId, updatedAt])
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasskeyCredential {
  id         String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports Json     @default("[]")
  deviceType String
  backedUp   Boolean  @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

model Site {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  description       String
  slug              String   @unique
  backgroundImage   String?
  backgroundColor   String   @default("#000000")
  fontColor         String   @default("#ffffff")
  searchUrlTemplate String   @default("https://www.google.com/search?q={query}")
  localSearchFirst  Boolean  @default(true)
  guestAccessEnabled      Boolean  @default(false)
  guestAccessPasswordHash String?
  settings          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Folder {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId     Int?
  parent       Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[] @relation("FolderTree")
  name         String
  icon         String?
  description  String?
  sortOrder    Int      @default(0)
  passwordHash String?
  passwordHint String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  links        Link[]

  @@index([userId, parentId, sortOrder])
}

model Link {
  id               Int       @id @default(autoincrement())
  folderId         Int
  folder           Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name             String
  url              String
  icon             String?
  description      String?
  sortOrder        Int       @default(0)
  healthCheckEnabled Boolean @default(true)
  healthStatus     String?
  healthStatusCode Int?
  healthReason     String?
  healthFinalUrl   String?
  healthCheckedAt  DateTime?
  clickCount       Int       @default(0)
  lastClickedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  clip             Clip?

  @@index([folderId, sortOrder])
  @@index([healthCheckedAt])
  @@index([clickCount, lastClickedAt])
}

model TrashItem {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  entityId  Int
  label     String
  payload   Json
  deletedAt DateTime @default(now())

  @@index([userId, deletedAt])
}

model ApiToken {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token")
  tokenPrefix String
  name        String
  scopes      String[]  @default(["bookmarks:read", "bookmarks:write", "ai:analyze"])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AppConfig {
  id                Int     @id @default(1)
  allowRegistration Boolean @default(false)
  defaultRole       String  @default("user")
  settings          Json    @default("{}")
  initializedAt     DateTime?
}

model BackupAutomation {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  cadence          String   @default("daily")
  hour             Int      @default(3)
  weekday          Int      @default(0)
  retentionDays    Int      @default(30)
  maxBackups       Int      @default(7)
  lastScheduledFor String?
  lastStartedAt    DateTime?
  lastCompletedAt  DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditConfig {
  id            Int      @id @default(1)
  retentionDays Int      @default(180)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUsername String
  actorRole     String
  action        String
  resourceType  String
  resourceId    String?
  resourceLabel String?
  result        String
  statusCode    Int
  ipAddress     String?
  userAgent     String?
  details       Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, createdAt])
  @@index([result, createdAt])
}

model NoStarAccount {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubLogin          String?
  githubName           String?
  githubAvatarUrl      String?
  githubTokenEncrypted String?
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model NoStarRepository {
  id                   Int             @id @default(autoincrement())
  userId               Int
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId             BigInt
  name                 String
  fullName             String
  description          String?
  htmlUrl              String
  stargazersCount      Int             @default(0)
  language             String?
  githubCreatedAt      DateTime?
  githubUpdatedAt      DateTime?
  githubPushedAt       DateTime?
  starredAt            DateTime?
  ownerLogin           String
  ownerAvatarUrl       String?
  topics               Json            @default("[]")
  aiSummary            String?
  aiTags               Json            @default("[]")
  aiPlatforms          Json            @default("[]")
  analyzedAt           DateTime?
  analysisFailed       Boolean         @default(false)
  customDescription    String?
  customTags           Json            @default("[]")
  customCategory       String?
  categoryLocked       Boolean         @default(false)
  lastEditedAt         DateTime?
  subscribedToReleases Boolean         @default(false)
  vectorIndexedAt      DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  releases             NoStarRelease[]

  @@unique([userId, githubId])
  @@unique([userId, fullName])
  @@index([userId, starredAt])
  @@index([userId, customCategory])
}

model NoStarRelease {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId     BigInt
  repositoryId Int
  repository   NoStarRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  tagName      String
  name         String?
  body         String?
  publishedAt  DateTime?
  htmlUrl      String?
  assets       Json             @default("[]")
  zipballUrl   String?
  tarballUrl   String?
  repoFullName String
  repoName     String
  prerelease   Boolean          @default(false)
  draft        Boolean          @default(false)
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, githubId])
  @@index([userId, publishedAt])
  @@index([repositoryId])
}

model NoStarCategory {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId    String?
  name        String
  description String?
  icon        String   @default("folder")
  keywords    Json     @default("[]")
  color       String?
  sortOrder   Int      @default(0)
  isCustom    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, sortOrder])
}

model NoStarAiProfile {
  id              String   @id @default(uuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String
  name            String
  apiType         String   @default("openai")
  baseUrl         String
  apiKeyEncrypted String?
  model           String
  isActive        Boolean  @default(false)
  customPrompt    String?
  useCustomPrompt Boolean  @default(false)
  concurrency     Int      @default(1)
  reasoningEffort String?
  mimoPlan        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarWebDavConfig {
  id                String   @id @default(uuid())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId          String
  name              String
  url               String
  username          String
  passwordEncrypted String?
  path              String   @default("/")
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarAssetFilter {
  id          String   @id @default(uuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId    String
  name        String
  description String?
  keywords    Json     @default("[]")
  platform    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, legacyId])
  @@index([userId, sortOrder])
}

model NoStarSetting {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model NoStarEmbeddingConfig {
  id              String                     @id @default(uuid())
  userId          Int
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyId        String
  name            String
  apiType         String                     @default("openai")
  baseUrl         String                     @default("")
  apiKeyEncrypted String?
  model           String                     @default("")
  dimensions      Int                        @default(1536)
  isActive        Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  vectorConfigs   NoStarVectorSearchConfig[]

  @@unique([userId, legacyId])
  @@index([userId, isActive])
}

model NoStarVectorSearchConfig {
  id                 Int                    @id @default(autoincrement())
  userId             Int                    @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled            Boolean                @default(false)
  workerUrl          String                 @default("")
  authTokenEncrypted String?
  embeddingConfigId  String?
  embeddingConfig    NoStarEmbeddingConfig? @relation(fields: [embeddingConfigId], references: [id], onDelete: SetNull)
  indexMode          String                 @default("readme")
  readmeMaxChars     Int                    @default(6000)
  status             Json?
  lastSyncAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Clip {
  id               Int             @id @default(autoincrement())
  userId           Int
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A clip may stand alone or hang off an existing bookmark. Deleting the bookmark detaches the
  // clip instead of destroying it.
  linkId           Int?            @unique
  link             Link?           @relation(fields: [linkId], references: [id], onDelete: SetNull)

  url              String
  canonicalUrl     String
  title            String
  author           String?
  siteName         String?
  domain           String
  description      String?
  excerpt          String
  contentHtml      String
  contentMd        String
  // Bumped whenever a refetch replaces the body, so highlights can tell whether their anchor was
  // captured against the text they are being resolved into.
  contentVersion   Int             @default(1)
  contentHash      String
  contentTruncated Boolean         @default(false)
  wordCount        Int             @default(0)
  lang             String?
  favicon          String?
  image            String?
  publishedAt      DateTime?

  status           String          @default("unread")
  starred          Boolean         @default(false)
  extractor        String
  sourceMeta       Json?
  clippedAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tags             ClipTagOnClip[]
  highlights       ClipHighlight[]

  @@unique([userId, canonicalUrl])
  @@index([userId, clippedAt])
  @@index([userId, status, clippedAt])
}

model ClipTag {
  id             Int             @id @default(autoincrement())
  userId         Int
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // `name` is what the user sees; `normalizedName` is lowercase NFKC and owns uniqueness, so
  // "Reading" and "reading" cannot both exist.
  name           String
  normalizedName String
  color          String?
  createdAt      DateTime        @default(now())
  clips          ClipTagOnClip[]

  @@unique([userId, normalizedName])
  @@index([userId, name])
}

model ClipTagOnClip {
  clipId Int
  tagId  Int
  // Denormalized so assignment queries filter by tenant without joining back through Clip.
  userId Int
  clip   Clip    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  tag    ClipTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clipId, tagId])
  @@index([tagId])
  @@index([userId])
}

model ClipHighlight {
  id             Int      @id @default(autoincrement())
  clipId         Int
  userId         Int
  clip           Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text           String
  note           String?
  // { quote, prefix, suffix, startOffset, endOffset } — text offsets alone break as soon as a
  // refetch rewrites the body, so the quote and its surrounding context are stored with them.
  anchor         Json
  contentVersion Int      @default(1)
  color          String   @default("yellow")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clipId, createdAt])
  @@index([userId])
}
