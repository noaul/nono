{
  "name": "2025-blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev --turbopack -p 2025",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "svg": "node scripts/gen-svgs-index.js",
    "build": "next build",
    "start": "next start",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/jsrsasign": "^10.5.15",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "html-react-parser": "^5.2.17",
    "jsrsasign": "^11.1.5",
    "katex": "^0.16.47",
    "lucide-react": "^0.553.0",
    "marked": "^17.0.6",
    "motion": "^12.43.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-debounce": "^4.0.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.11.26",
    "code-inspector-plugin": "^1.6.6",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "~4.116.0"
  }
}
